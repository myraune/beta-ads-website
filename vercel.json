{
  "buildCommand": "node scripts/generate-blog-meta.mjs && node scripts/generate-sitemap.mjs && vite build && node scripts/generate-seo-pages.mjs",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/how-it-works",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/twitch-advertising-cost",
      "permanent": true
    },
    {
      "source": "/pricing/:path*",
      "destination": "/twitch-advertising-cost",
      "permanent": true
    },
    { "source": "/careers/:path*", "destination": "/about", "permanent": true },
    { "source": "/career/:path*", "destination": "/about", "permanent": true },
    { "source": "/jobs/:path*", "destination": "/about", "permanent": true },
    { "source": "/jobb/:path*", "destination": "/about", "permanent": true },
    { "source": "/jobb-hos-oss/:path*", "destination": "/about", "permanent": true },
    { "source": "/jobbe-hos-oss/:path*", "destination": "/about", "permanent": true },
    { "source": "/karriere/:path*", "destination": "/about", "permanent": true },
    { "source": "/stillinger/:path*", "destination": "/about", "permanent": true },
    { "source": "/ledige-stillinger/:path*", "destination": "/about", "permanent": true },
    { "source": "/medarbeidere/:path*", "destination": "/about", "permanent": true },
    { "source": "/vacancies/:path*", "destination": "/about", "permanent": true },
    { "source": "/company/careers/:path*", "destination": "/about", "permanent": true },
    { "source": "/en/career/:path*", "destination": "/about", "permanent": true },
    {
      "source": "/blog/how-twitch-advertising-works-2024",
      "destination": "/blog/how-twitch-advertising-works-2026",
      "permanent": true
    },
    {
      "source": "/blog/samsung-twitch-campaign-case-study",
      "destination": "/case-study/samsung",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "no" }],
      "destination": "/norge",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "sv" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "fi" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "da" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/surfsharklive",
      "destination": "https://stream-wall.vercel.app/surfsharklive"
    },
    {
      "source": "/surfsharklive/:path*",
      "destination": "https://stream-wall.vercel.app/surfsharklive/:path*"
    },
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]{2,4}$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/lovable-uploads/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=43200, stale-while-revalidate=3600" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Permissions-Policy", "value": "browsing-topics=(), interest-cohort=(), camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/clip-analytics-preview/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    }
  ]
}