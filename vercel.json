{
  "buildCommand": "node scripts/generate-sitemap.mjs && vite build && node scripts/generate-seo-pages.mjs",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/how-it-works",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/blog/how-twitch-advertising-works-2024",
      "destination": "/blog/how-twitch-advertising-works-2026",
      "permanent": true
    },
    {
      "source": "/blog/samsung-twitch-campaign-case-study",
      "destination": "/case-study/samsung",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "no" }],
      "destination": "/norge",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "sv" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "fi" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "da" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]{2,4}$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/lovable-uploads/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=43200, stale-while-revalidate=3600" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}